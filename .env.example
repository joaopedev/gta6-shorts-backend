PORT=4100
FRONTEND_URL=http://localhost:3000

# Chave obtida no painel da HikerAPI
HIKER_API_KEY=
HIKER_API_BASE_URL=https://api.hikerapi.com

# Banco e mídia locais
DATABASE_PATH=.data/gta6-shorts.sqlite
MEDIA_STORAGE_PATH=.data/media
PROCESSED_MEDIA_PATH=.data/processed
CUTS_STORAGE_PATH=.data/cuts

# OpenAI: roteiro, voz e agente de cortes com transcrição temporal
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# OAuth do Google/YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4100/api/youtube/callback

# 32 bytes em base64. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Se APP_ENCRYPTION_KEY estiver vazia, o backend gera esta chave local automaticamente.
APP_ENCRYPTION_KEY_FILE=.data/app.key
